<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="16.2.0" />
        <!-- AB#4989: OpenIddict store abstractions (the previous IdentityServer dependency was removed with AB#4996). -->
        <PackageReference Include="OpenIddict.Abstractions" Version="7.6.0" />
        <!-- direct reference: the released SDK still ships the legacy IdentityModel until the next libs train -->
        <PackageReference Include="Duende.IdentityModel" Version="8.1.0" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\IdentityServices.Resources\IdentityServices.Resources.csproj" />
        <PackageReference Include="Meshmakers.Octo.Runtime.Engine.MongoDb" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.Services.Infrastructure" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.Services.Notifications" Version="$(OctoCoreLibVersion)" />
        <ProjectReference Include="..\Persistence.IdentityCkModel\Persistence.IdentityCkModel.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="IdentityServerPersistence.UnitTests" />
        <InternalsVisibleTo Include="IdentityServices.IntegrationTests" />
        <InternalsVisibleTo Include="IdentityServices.UnitTests" />
    </ItemGroup>

</Project>
