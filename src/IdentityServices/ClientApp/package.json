{
  "name": "identity-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node aspnetcore-https",
    "start": "ng serve --port 44400 --host=0.0.0.0",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test --watch=false",
    "extract-i18n": "ng extract-i18n",
    "postinstall": "node -e \"var s=require('path').join(__dirname,'src/environments/version.ts');require('fs').existsSync(s)?require('child_process').execSync('node \\\"'+s+'\\\"',{stdio:'inherit'}):console.log('Version generation skipped')\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ngx-translate/core": "17.0.0",
    "@progress/kendo-angular-buttons": "^24.2.2",
    "@progress/kendo-angular-common": "^24.2.2",
    "@progress/kendo-angular-icons": "^24.2.2",
    "@progress/kendo-angular-inputs": "^24.2.2",
    "@progress/kendo-angular-l10n": "^24.1.0",
    "@progress/kendo-angular-layout": "^24.2.2",
    "@progress/kendo-angular-popup": "^24.2.2",
    "@progress/kendo-licensing": "^1.13.1",
    "@progress/kendo-theme-default": "^14.10.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.9",
    "angular-eslint": "22.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true,
    "@progress/kendo-licensing": true,
    "fsevents": true
  }
}
